# CarbonLens Environment Configuration Example
SECRET_KEY=dev-secret-key-change-in-production-2026-carbonlens
DATABASE_URL=sqlite:///instance/carbonlens.db
FLASK_ENV=development
FLASK_DEBUG=1
MAX_CONTENT_LENGTH_MB=16
UPLOAD_FOLDER=uploads
EXPORTS_FOLDER=exports

